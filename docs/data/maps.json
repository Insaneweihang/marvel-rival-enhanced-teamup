  "objective_types": [
    {
      "name": "Convergence",
      "summary": "Attackers capture a mission area, then escort a mission vehicle after the area is captured."
    },
    {
      "name": "Convoy",
      "summary": "Attackers escort a moving vehicle while defenders try to stop it before time expires."
    },
    {
      "name": "Domination",
      "summary": "Both teams fight to control a mission area and win rounds by reaching full progress."
    },
    {
      "name": "Resource Rumble",
      "summary": "Teams fight over mission areas to harvest resources. Listed as no longer available in the referenced map list."
    },
    {
      "name": "Conquest",
      "summary": "Arcade team mode focused on defeating enemies and collecting points."
    },
    {
      "name": "Doom Match",
      "summary": "Arcade free-for-all mode where players compete for final hits."
    },
    {
      "name": "Annihilation",
      "summary": "Arcade combat mode listed separately from the standard Quick Match and Competitive map pool."
    },
    {
      "name": "Bounty Annihilation",
      "summary": "Arcade combat mode listed separately from the standard Quick Match and Competitive map pool."
    },
    {
      "name": "Event",
      "summary": "Limited-time or event-specific map variants and arenas."
    },
    {
      "name": "Social",
      "summary": "Non-combat spaces centered on player interaction."
    },
    {
      "name": "Training",
      "summary": "Practice and tutorial spaces."
    }
  ],
